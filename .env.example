# ==========================================
# 1. LLM & EMBEDDING CONFIG (TOKEN HARBOR)
# ==========================================
TOKEN_HARBOR_API_KEY=your_token_harbor_api_key_here
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
LLM_MODEL_NAME=deepseek-v4.1-flash:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# Embedding Model (FastEmbed BAAI/bge-small-en-v1.5)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ==========================================
# 2. BACKEND & AUTHENTICATION (FASTAPI)
# ==========================================
APP_NAME=KafMind
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
UPLOAD_DIR=uploads

# ==========================================
# 3. CORE DATABASE & CACHE (POSTGRES + REDIS)
# ==========================================
POSTGRES_USER=kafmind_user
POSTGRES_PASSWORD=kafmind_pass
POSTGRES_DB=kafmind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kafmind_user:kafmind_pass@localhost:5432/kafmind_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 4. VECTOR DATABASE (QDRANT)
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=kafmind_documents

# ==========================================
# 5. EVENT STREAMING (APACHE KAFKA - KRAFT)
# ==========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILE_UPLOADED=file.uploaded
KAFKA_TOPIC_FILE_STATUS=file.status
KAFKA_CONSUMER_GROUP=kafmind-ingestion-group

# ==========================================
# 6. FRONTEND CONFIG (VITE / REACT)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
